type User {
  id: ID! @id
  round : Int!
  username: String! @unique
  mobile : Int! @unique
  isExpert : Boolean! @default(value : false)
  createdAt: DateTime! @createdAt
  updatedAt: DateTime! @updatedAt
}

type AcceptRecord {
  id: ID! @id
  date : String!
}


type Question {
  id: ID! @id
  round : Int!
  quetionTitle: String!
  sort: Int!
  createdAt: DateTime! @createdAt
  updatedAt: DateTime! @updatedAt
}
