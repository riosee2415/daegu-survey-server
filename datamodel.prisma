type User {
  id: ID! @id
  round : Int!
  username: String!
  mobileNumber : String!
  isExpert : Boolean! @default(value : false)
  isManager : Boolean! @default(value : false)
  isComplete : Boolean! @default(value : false)
  createdAt: DateTime! @createdAt
  updatedAt: DateTime! @updatedAt
}

type AdminUser {
  id: ID! @id
  userId: String!
  password: String!
  createdAt: DateTime! @createdAt
  updatedAt: DateTime! @updatedAt
}

type AcceptRecord {
  id: ID! @id
  date : String!
}


type Question {
  id: ID! @id
  round : Int!
  quetionTitle: String!
  sort: Int!
  createdAt: DateTime! @createdAt
  updatedAt: DateTime! @updatedAt
}

type Evaluation {
  id: ID! @id
  user: User!
  question: Question!
  score: Int!
  description: String!
  createdAt: DateTime! @createdAt
  updatedAt: DateTime! @updatedAt
}

type Evaluation2 {
  id: ID! @id
  user: User!
  score: Int!
  description: String
  sort: Int!
  createdAt: DateTime! @createdAt
  updatedAt: DateTime! @updatedAt
}

type Streaming {
  id: ID! @id
  key: String!
  createdAt: DateTime! @createdAt
  updatedAt: DateTime! @updatedAt
}

type Starting {
  id: ID! @id
  isStart: Boolean!
}

type LoginLog {
  id: ID! @id
  username: String!
  createdAt: DateTime! @createdAt
  updatedAt: DateTime! @updatedAt
}

type MainText {
  id: ID! @id
  text: String!
  createdAt: DateTime! @createdAt
  updatedAt: DateTime! @updatedAt
}

